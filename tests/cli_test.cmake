file(MAKE_DIRECTORY "${TEST_DIR}")
set(data "${TEST_DIR}/synthetic.data")
execute_process(COMMAND "${DEMO}" "${data}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Fixture generation failed: ${errors}")
endif()
function(check_output expected_status pattern)
    execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status EQUAL expected_status OR NOT "${output}${errors}" MATCHES "${pattern}")
        message(FATAL_ERROR "CLI ${ARGN}: exit=${status}, stdout=${output}, stderr=${errors}")
    endif()
endfunction()
check_output(0 "Checkpoints: 7" info "${data}")
check_output(0 "Steps: 0..600" info "${data}")
check_output(0 "Values: 8" get "${data}" 300)
check_output(0 "Preview: 3 4 5 6 7 8 9 10" get "${data}" 300)
check_output(0 "Checkpoints: 4" range "${data}" 200 500)
check_output(0 "Checkpoints: 0" range "${data}" 500 200)
check_output(2 "Checkpoint step not found" get "${data}" 999)
check_output(1 "unsigned 64-bit integer" get "${data}" -1)
check_output(1 "unsigned 64-bit integer" get "${data}" 18446744073709551616)
check_output(0 "Checkpoints: 0" range "${data}" 18446744073709551615 18446744073709551615)
check_output(1 "file does not exist" info "${TEST_DIR}/absent.data")
if(EXISTS "${TEST_DIR}/absent.data")
    message(FATAL_ERROR "Reading a missing file created it")
endif()
check_output(0 "Navier checkpoint explorer" --help)
check_output(1 "Invalid command" invalid "${data}")
