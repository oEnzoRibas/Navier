file(MAKE_DIRECTORY "${TEST_DIR}")
set(data "${TEST_DIR}/synthetic.data")
execute_process(COMMAND "${DEMO}" "${data}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Viewer fixture failed: ${errors}")
endif()
file(WRITE "${data}.json" "{\"solver\":\"test\",\"nx\":4,\"ny\":2,\"fields\":[\"scalar\"],\"boundary\":\"<test>\"}")
execute_process(COMMAND "${VIEWER}" "${TEST_DIR}/viewer.html" "${data}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Viewer export failed: ${errors}")
endif()
file(READ "${TEST_DIR}/viewer.html" html)
if(NOT html MATCHES "Navier" OR NOT html MATCHES "\"step\":\"300\"" OR NOT html MATCHES "\"data\":")
    message(FATAL_ERROR "Generated GUI is missing real checkpoint frames")
endif()
if(html MATCHES "\"boundary\":\"<test>\"")
    message(FATAL_ERROR "Sidecar HTML delimiters were not escaped")
endif()
execute_process(COMMAND "${VIEWER}" "${TEST_DIR}/empty.html" RESULT_VARIABLE status OUTPUT_VARIABLE output)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Empty GUI export failed")
endif()
file(WRITE "${TEST_DIR}/preserved.html" "TEST_SENTINEL")
execute_process(COMMAND "${VIEWER}" "${TEST_DIR}/preserved.html" "${TEST_DIR}/absent.data"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(status EQUAL 0)
    message(FATAL_ERROR "Missing data should fail viewer generation")
endif()
file(READ "${TEST_DIR}/preserved.html" preserved)
if(NOT preserved STREQUAL "TEST_SENTINEL")
    message(FATAL_ERROR "Invalid input overwrote an existing viewer")
endif()
