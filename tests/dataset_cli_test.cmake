file(MAKE_DIRECTORY "${TEST_DIR}")
set(data "${TEST_DIR}/fixture.data")
file(REMOVE "${data}" "${data}.nvi" "${data}.nvi.rebuild")
execute_process(COMMAND "${BENCH}" "${data}" 4 8 6 2 RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "V2 fixture generation failed: ${errors}")
endif()
function(check command)
  execute_process(COMMAND "${CLI}" ${command} ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${command} failed: ${errors}")
  endif()
  set(last_output "${output}" PARENT_SCOPE)
endfunction()
check(info-json "${data}")
string(JSON version GET "${last_output}" format)
string(JSON scanned GET "${last_output}" recordsScanned)
if(NOT version STREQUAL "NAVIER02" OR NOT scanned EQUAL 0)
  message(FATAL_ERROR "Wrong format or persistent index scanned checkpoints")
endif()
check(list-json "${data}" 0 18446744073709551615 2)
string(JSON next GET "${last_output}" nextStep)
if(NOT next STREQUAL "9")
  message(FATAL_ERROR "Incorrect uint64 pagination")
endif()
check(checkpoint-json "${data}" 21)
check(fields "${data}" 21)
check(extract "${data}" 21 field_0 "${TEST_DIR}/field.bin")
file(SIZE "${TEST_DIR}/field.bin" size)
if(NOT size EQUAL 264)
  message(FATAL_ERROR "Selective float32 field export has incorrect size")
endif()
check(validate "${data}" quick)
check(validate "${data}" full)
check(query "${data}" sequence 1 2)
if(NOT last_output MATCHES "\"step\":\"8\"" OR NOT last_output MATCHES "\"step\":\"16\"")
  message(FATAL_ERROR "Secondary metric query is incorrect")
endif()
execute_process(COMMAND "${CLI}" extract "${data}" 21 missing RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(NOT status EQUAL 2)
  message(FATAL_ERROR "Missing field must return status 2")
endif()
